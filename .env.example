JWT_ACCESS_TTL_SECS=64800
JWT_REFRESH_TTL_SECS=2592000
JWT_AUDIENCE="http://localhost:8082/"
JWT_ISSUER="http://localhost:8082/"
JWT_AUTH_URL="http://localhost:8082/auth/login"
JWT_AUTH_TOKEN_URL="http://localhost:8082/auth/token"

# Rate limits (requests/minute per client IP)
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_GENERAL_PER_MINUTE=300
# Enable ONLY behind a trusted reverse proxy (reads X-Forwarded-For)
RATE_LIMIT_TRUST_PROXY_HEADERS=false

# Swagger UI (/docs) and OpenAPI spec (/openapi.json); defaults to on except in production
DOCS_ENABLED=true

# OTP / uploads / staff roles
OTP_EXPIRY_MINUTES=5
ALLOWED_STAFF_EMAIL_DOMAINS="hrpropertymaintenance.ca,impacttxtech.com"
UPLOAD_DIR="uploads"
MAX_UPLOAD_FILE_SIZE=10
