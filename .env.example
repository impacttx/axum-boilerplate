HOST=0.0.0.0
PORT=8080
RUST_LOG=info,tower_http=debug

ENVIRONMENT=development
LOG_LEVEL=DEBUG
ADMIN_EMAIL="admin@example.com"
ADMIN_MOBILE="+919876543210"
ADMIN_PASSWORD="change-me-min-8-chars-and-specials"

FRONTEND_BASE_URL="http://localhost:3000"
CORS_ORIGINS='["http://localhost:3000","http://localhost:8082"]'

# Config for DB
POSTGRES_USER=xumboil
POSTGRES_PASSWORD=xumboil
POSTGRES_DB=xumboil
POSTGRES_HOST=database
POSTGRES_PORT=5432
POSTGRES_USE_SSL=False
# Optional: overrides POSTGRES_* (use when running on the host instead of docker)
DATABASE_URL="postgres://xumboil:xumboil@localhost:5432/xumboil?sslmode=disable"

SECRET_KEY="your_secret_key"

# Google Sign-In: the OAuth client ID that issues the ID tokens (leave empty to disable /v1/auth/google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email services
# EMAIL_PROVIDER="Mailgun" # Options: Mailgun, LogOnly (default: LogOnly)
EMAIL_PROVIDER="LogOnly"
MAIL_FROM="Name <system@example.com>"
# Optional reply-to email addresses (comma-separated). Leave unset/empty to omit the header.
# Must be an inbox on the main domain's MX (e.g. Google Workspace); the mailer domain is outbound-only.
MAIL_REPLY_TO="Name <username@example.com>, Name 2 <another@example.com>"
# Optional CC email addresses (comma-separated). Leave unset/empty to omit.
MAIL_CC_TO="Name <username@example.com>, Name 2 <another@example.com>"
# Mailgun for production email sending
MAILGUN_API_KEY="xxx"
MAILGUN_DOMAIN="example.com"
MAILGUN_API_BASE_URL="https://api.mailgun.net/v3/${MAILGUN_DOMAIN}/messages"

# DigitalOcean Spaces Placeholders (Update with real creds)
DO_SPACES_KEY="your_key"
DO_SPACES_SECRET="your_secret"
DO_SPACES_REGION="nyc3"
DO_SPACES_BUCKET="xumboil-dev"
DO_SPACES_ENDPOINT="https://nyc3.digitaloceanspaces.com"
DO_SPACES_CDN_ENDPOINT="https://xumboil-dev.nyc3.cdn.digitaloceanspaces.com"

# Generate your private key using
# ❯ ssh-keygen -t rsa -b 4096 -f ~/.ssh/id_rsa_test
# Then copy the content of the file and paste below within double quotes
# ❯ cat ~/.ssh/id_rsa_test | pbcopy
# Dev-only benchmark keypair; generate your own for real deployments:
# ❯ openssl genrsa 2048 > private.pem && openssl rsa -in private.pem -pubout > public.pem
